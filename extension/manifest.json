{
  "manifest_version": 3,
  "name": "Sinehan",
  "version": "2.12.0",
  "description": "Watch together: synced playback, chat and video call.",
  "permissions": ["storage", "sidePanel", "tabs", "clipboardWrite", "notifications", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Open Sinehan", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bantay.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
