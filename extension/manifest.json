{
  "manifest_version": 3,
  "name": "Sinehan",
  "version": "1.7.0",
  "description": "Watch together: synced playback, chat and video call.",
  "permissions": ["storage", "sidePanel", "tabs", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Sinehan" },
  "side_panel": { "default_path": "sidepanel.html" },
  "web_accessible_resources": [{ "resources": ["fonts/inter.woff2"], "matches": ["<all_urls>"] }],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["netflix-main.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
